{
  "manifest_version": 3,
  "name": "TabQA",
  "version": "0.1",
  "description": "Ask questions about the current tab with explicit user consent.",

  "permissions": ["activeTab"],

  "host_permissions": [
    "http://127.0.0.1/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
